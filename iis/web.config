<?xml version="1.0" encoding="utf-8"?>
<!-- Copiado para C:\inetpub\flow pelo Instalar-IIS.ps1, que troca SEGREDO_PARTILHADO e a porta. Não guardar o segredo real no repositório. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Flow" stopProcessing="true">
          <match url="(.*)" />
          <!-- Sobrescreve sempre estes cabeçalhos: um valor forjado pelo cliente nunca chega ao agente -->
          <serverVariables>
            <set name="HTTP_X_REMOTE_USER" value="{LOGON_USER}" />
            <set name="HTTP_X_PROXY_SECRET" value="SEGREDO_PARTILHADO" />
          </serverVariables>
          <action type="Rewrite" url="http://localhost:5080/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <!-- O chat é enviado à medida que é gerado: a compressão dinâmica juntava tudo até ao fim (o agente já faz gzip da página) -->
    <urlCompression doDynamicCompression="false" />
  </system.webServer>
</configuration>
