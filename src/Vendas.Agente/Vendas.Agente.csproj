<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.6.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="OllamaSharp" Version="5.4.30" />
    <!-- smtp.pwd (DPAPI), como o sql.pwd do servidor: a mesma versão -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- O agente arranca a dll do servidor (não usa o código): isto garante que é compilada sempre que o agente o é. -->
    <ProjectReference Include="..\Vendas.Servidor\Vendas.Servidor.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

    <ItemGroup>
  <!-- O ficheiro passa a viajar dentro do .exe -->
  <EmbeddedResource Include="Pagina\pagina-chat.html" />
    </ItemGroup>

  <ItemGroup>
  <!-- Fonte 72: servida em /fonts/<ficheiro> pelo ModoWebAsync -->
  <EmbeddedResource Include="fonts\*.woff2" LogicalName="fonts/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
