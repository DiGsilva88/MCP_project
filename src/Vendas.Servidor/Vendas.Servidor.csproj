<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Vendas.Servidor</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
   
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.13" />
    <!-- Transitivo via Microsoft.Data.SqlClient; fixado para corrigir CVE-2026-84008 / CVE-2026-70162. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Permite aos testes exercitar ConsultaClientes (internal) sem tornar a API pública. -->
    <InternalsVisibleTo Include="Vendas.Servidor.Tests" />
  </ItemGroup>

</Project>
